# Server-only Buttondown API key with subscriber write access.
# Add the same key as BUTTONDOWN_API_KEY in Vercel project settings.
BUTTONDOWN_API_KEY=replace_with_buttondown_api_key

# Microsoft Clarity project ID (clarity.microsoft.com > Settings > Overview).
# Public by design; leave unset to disable Clarity.
NEXT_PUBLIC_CLARITY_PROJECT_ID=replace_with_clarity_project_id
